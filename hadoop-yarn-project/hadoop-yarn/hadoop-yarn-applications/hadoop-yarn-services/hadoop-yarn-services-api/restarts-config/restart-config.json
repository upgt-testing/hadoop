{
  "tests": [
    {
      "testClass": "org.apache.hadoop.yarn.service.TestCleanupAfterKill_RestartInjected",
      "testMethod": "testRegistryCleanedOnLifetimeExceeded",
      "restartPoints": [
        {
          "position": "after_cluster_setup",
          "targets": ["resourcemanager"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_app_create",
          "targets": ["resourcemanager"],
          "modes": ["GRACEFUL", "CRASH", "DELAYED_CRASH"]
        }
      ]
    }
  ]
}
