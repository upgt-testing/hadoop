          "position": "after_first_reencryption",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_key_roll",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_second_reencryption",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH", "DELAYED_CRASH"]
        }
      ]
    },
    {
      "testClass": "org.apache.hadoop.hdfs.server.namenode.TestReencryption_RestartInjected",
