{
  "tests": [
    {
      "testClass": "org.apache.hadoop.hdfs.server.namenode.TestRedudantBlocks_RestartInjected",
      "testMethod": "testProcessOverReplicatedAndRedudantBlock",
      "restartPoints": [
        {
          "position": "after_striped_file_creation",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_blocks_injected",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_first_block_reports",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_redundant_block_injected",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_second_block_reports",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_redundant_block_deleted",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_reconstruction_complete",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH", "DELAYED_CRASH"]
        }
      ]
    }
  ]
}
