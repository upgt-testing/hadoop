{
  "tests": [
    {
      "testClass": "org.apache.hadoop.net.TestNetworkTopology_RestartInjected",
      "testMethod": "testInvalidNetworkTopologiesNotCachedInHdfs",
      "restartPoints": [
        {
          "position": "after_cluster_start",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
