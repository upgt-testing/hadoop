        {
          "position": "after_first_dn_registered",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_topology_fix",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_dn_restart",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_both_dns_registered",
          "targets": ["namenode", "datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        }
      ]
    }
  ]
}
