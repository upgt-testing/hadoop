        },
        {
          "position": "after_block_added",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_file_completed",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        }
      ]
    }
  ]
