{
  "tests": [
    {
      "testClass": "org.apache.hadoop.hdfs.web.TestWebHdfsWithMultipleNameNodes_RestartInjected",
      "testMethod": "testRedirect",
      "restartPoints": [
        {
          "position": "after_cluster_start",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_file_creation",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_first_length_check",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_first_read",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_append",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_second_length_check",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_second_read",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        }
      ]
    }
  ]
}
