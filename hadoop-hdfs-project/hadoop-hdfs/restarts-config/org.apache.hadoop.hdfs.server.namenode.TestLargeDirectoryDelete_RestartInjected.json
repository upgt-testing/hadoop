{
  "tests": [
    {
      "testClass": "org.apache.hadoop.hdfs.server.namenode.TestLargeDirectoryDelete_RestartInjected",
      "testMethod": "largeDelete",
      "restartPoints": [
        {
          "position": "after_cluster_start",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_file_creation",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "before_large_delete",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_large_delete",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        }
      ]
    }
  ]
}
