{
  "tests": [
    {
      "testClass": "org.apache.hadoop.hdfs.web.TestWebHdfsWithAuthenticationFilter_RestartInjected",
      "testMethod": "testWebHdfsAuthFilter",
      "restartPoints": [
        {
          "position": "after_cluster_start",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_unauthorized_attempt",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_authorization_change",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_authorized_operation",
          "targets": ["datanode"],
          "modes": ["GRACEFUL", "CRASH"]
        }
      ]
    }
  ]
}
