{
  "tests": [
    {
      "testClass": "org.apache.hadoop.hdfs.server.namenode.TestNameNodeResourceChecker_RestartInjected",
      "testMethod": "testCheckThatNameNodeResourceMonitorIsRunning",
      "restartPoints": [
        {
          "position": "after_cluster_active",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_resource_check",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_resource_threshold_crossed",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_safe_mode_entered",
          "targets": ["namenode"],
          "modes": ["GRACEFUL", "CRASH"]
        }
      ]
    }
  ]
}
